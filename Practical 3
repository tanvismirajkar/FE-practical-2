import numpy as np
data=np.array([1000,2000,5000,10000])
print("Original Data")
print(data)
max_value=np.max(np.abs(data))
j=len(str(int(max_value)))
scaled=data/(10**j)
print("\nValue of j=",j)
print("\nDecimal Scaled Data")
print(scaled)
