from sklearn.preprocessing import RobustScaler,StandardScaler
import pandas as pd
 
data=pd.DataFrame({
"Amount":[1000,2000,3000,50000]
})
# RobustScaler
robust=RobustScaler()
robust_scaled=robust.fit_transform(data)
# StandardScaler
standard=StandardScaler()
standard_scaled=standard.fit_transform(data)
print("Original Data")
print(data)
print("\nRobustScaler")
print(pd.DataFrame(robust_scaled,columns=["Amount"]))
print("\nStandardScaler")
print(pd.DataFrame(standard_scaled,columns=["Amount"]))
 
 
import numpy as np
