
data=np.array([5,7,8,6,9,10,50])
Q1=np.percentile(data,25)
Q3=np.percentile(data,75)
IQR= Q3-Q1
 
lower=Q1-1.5*IQR
upper=Q3+1.5*IQR
 
Outliers=data[(data<lower)|(data>upper)]
 
print("Q1:",Q1)
print("Q3:",Q3)
print("QR:,QR")
print("Lower Bound:",lower)
print("Upper Bound:",upper)
print("Outliers:",Outliers) 
