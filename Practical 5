import pandas as pd
income=[5000,10000,20000,50000,100000]
df=pd.DataFrame({"Income":income})
#Equal Width
df["Equal Width"]=pd.cut(df["Income"],bins=3)
#Equal Frequency
df["Equal Frequency"]=pd.qcut(df["Income"],q=3)
#Custom Binning
bins=[0,20000,50000,100000]
labels=["Low","Medium","High"]
df["Custom Bin"]=pd.cut(df["Income"],
               bins=bins,
               labels=labels,
               include_lowest=True)
print(df)           
