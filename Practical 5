import pandas as pd
marks=[23,45,56,67,78,89,90]
df=pd.DataFrame({"Marks":marks})
#Equal Width Binning
df["Equal Width Bin"]=pd.cut(df["Marks"],bins=3)
print("Student Marks")
print(df)
print("\nBin Ranges:")
print(df["Equal Width Bin"].value_counts().sort_index())
