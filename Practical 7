Questionno4:Time Difference(Days)
import pandas as pd
start_dates=[
             '2026-01-10','2026-02-14','2026-03-10','2026-04-15','2026-05-10',
             '2026-06-12','2026-07-20','2026-08-09','2026-09-21','2026-10-28'
]
end_dates=[
           ' 2026-01-25','2026-02-20','2026-03-25','2026-04-28','2026-05-25',
           '2026-06-20','2026-07-25','2026-08-30','2026-09-28','2026-10-30'
]
df=pd.DataFrame({
  "Start":pd.to_datetime(start_dates),
  "End":pd.to_datetime(end_dates)
})
 
df["Difference(Days)"]=(df["End"]-df["Start"]).dt.days
 
print(df)
