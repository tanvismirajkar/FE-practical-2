Question no2:Identify Weekday/Weekend
import pandas as pd
import numpy as np
dates=[
   '2026-05-16','2026-05-17','2026-05-12','2026-04-14','2026-04-8','2026-03-24',
   '2026-2-12','2026-02-1','2026-01-14','2026-01-12'
]
df=pd.DataFrame({"Date":pd.to_datetime(dates)})
df["Day"]=df["Date"].dt.day_name()
df["Type"] =np.where(df["Date"].dt.weekday>=5,
          "Weekend",
          "Weekday")
print(df)
