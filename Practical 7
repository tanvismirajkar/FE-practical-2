Question no5:Age from DOB
import pandas as pd
 
dob=[
     '2000-05-10','1998-08-22','1995-12-01','1992-03-15','1990-07-30',
     '1988-11-25','1985-06-18','1982-09-09','1980-01-01','1975-04-20'
]
today=pd.Timestamp.today()
 
df=pd.DataFrame({"DOB":pd.to_datetime(dob)})
 
df["Age"]=((today-df["DOB"]).dt.days/365.25).astype(int)
print(df)
