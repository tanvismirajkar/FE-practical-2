Question no1:Extract Day ,Month and Year
import pandas as pd
dates=[
       '2026-01-15','2026-02-20','2026-03-15','2026-04-18','2026-05-25','2026-06-10',
       '2026-07-22','2026-08-30','2026-09-12','2026-10-15'
]
 
df=pd.DataFrame({"Date":pd.to_datetime(dates)})
df["Day"]=df["Date"].dt.day
df["Month"]=df["Date"].dt.month
df["Year"]=df["Date"].dt.year
 
print(df)
