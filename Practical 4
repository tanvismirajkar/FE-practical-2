import pandas as pd
from sklearn.preprocessing import LabelEncoder
df=pd.DataFrame({
"Vehicle Type":["Car","Bike","Truck","Car","Bike"]
})
print("Original Data:")
print(df)
le=LabelEncoder()
df["Encoded"]=le.fit_transform(df["Vehicle Type"])
print("\nEncodedData:")
print(df)
