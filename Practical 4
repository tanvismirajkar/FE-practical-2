import pandas as pd
df=pd.DataFrame({
"Room Type":["Standard","Deluxe","Suite","Deluxe"]
})
print("Original Data:")
print(df)
order={"Standard":0,"Deluxe":1,"Suite":2}
df["Encoded"]=df["Room Type"].map(order)
print("\nOrdinal Encoded Data:")
print(df)
