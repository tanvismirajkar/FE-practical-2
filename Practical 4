import pandas as pd
import category_encoders as ce
df=pd.DataFrame({
"Product Code":["A12","B34","C56","A12","D78"]
})
print("Original Data:")
print(df)
encoder=ce.BinaryEncoder(cols=["Product Code"])
encoded=encoder.fit_transform(df)
print("\nBinary Encoded Data:")
print(encoded)
